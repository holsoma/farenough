---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="This stop does not exist" description="This page could not be found. Return to farenough or open the guide."><div class="wrap not-found"><p>404 · Page not found</p><h1>A stop too far.</h1><p>This page is not on the route. You can return home or find what you need in the guide.</p><div class="actions"><a class="button" href={base}>Back to farenough <span aria-hidden="true">→</span></a><a class="text-link" href={`${base}docs/`}>Open the guide <span aria-hidden="true">→</span></a></div></div></Base>
