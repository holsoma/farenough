---
import Base from '../../layouts/Base.astro';
import { guides } from '../../data/release';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="The fairenough guide" description="Set up a pass, record or import journeys, understand your fare comparison and keep a backup."><div class="wrap inner-page"><header class="page-head"><h1>A clear record.<br />A clear answer.</h1><p class="lead">Everything you need to use fairenough, understand its figures and keep your data.</p></header><nav class="guide-index" aria-label="Guides">{guides.map(([slug, title]) => <a href={`${base}docs/${slug}/`}>{title}<span aria-hidden="true">→</span></a>)}</nav></div></Base>
