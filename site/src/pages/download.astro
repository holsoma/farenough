---
import Base from '../layouts/Base.astro';
import { release } from '../data/release';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={release.published ? 'Get the Android app' : 'Release preview'} description="Check farenough release availability, installation instructions and how to keep your records when updating.">
  <div class="wrap inner-page"><header class="page-head"><h1>{release.published ? 'Your next journey starts here.' : 'The first release, in preparation.'}</h1><p class="lead">An Android installation file, called an APK. Android {release.minimumAndroid} or later. Your records stay on your device.</p></header>
    <section class="download-panel" aria-labelledby="release-title"><div><h2 id="release-title">farenough {release.version}</h2><p>{release.published ? `Released ${release.date}` : 'The public APK is not available yet. Its download link will appear here when released.'}</p><p>Undergraduate train passes. MRT and LRT. Automatic fares.</p></div>{release.published ? <a class="button" href={release.apk}>Download APK <span aria-hidden="true">↓</span></a> : <a class="button" href={`${base}docs/getting-started/`}>Read the setup guide <span aria-hidden="true">→</span></a>}</section>
    <article class="prose"><h2>{release.published ? 'Install once. Keep your records.' : 'How to install when it is released'}</h2><ol><li>Download the APK from the GitHub release.</li><li>Open it on your Android phone. If Android asks, allow installation from the browser or file manager you are using.</li><li>Install farenough and set up the actual dates and price of your pass.</li></ol><p>For updates, install the new signed APK over the existing app. Do not uninstall first. Create a backup before updating.</p><p>{release.published ? 'The release includes' : 'The published release will include'} a SHA-256 file checksum. The repository documents the app's signing certificate. A matching checksum checks the downloaded file; the certificate identifies its signer.</p><h2>What this version calculates</h2><p>It compares recorded regular adult fares with the undergraduate train pass price. Selecting stations calculates their adult fare and rail fare distance offline for travel dates from 12 July through 25 December 2026. Saved route fares can override these amounts or cover other dates. Individual corrections account for known discounts. Missing fares are clearly marked.</p><p><a href={`${base}docs/getting-started/`}>Get started</a> or <a href={`${base}docs/backups-and-updates/`}>read the backup and update guide</a>.</p></article>
  </div>
</Base>
