{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holsoma.github.io/fairenough/schemas/trips-v1.schema.json",
  "title": "fairenough journey import v1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "version", "trips"],
  "properties": {
    "format": {"const": "fairenough-trips"},
    "version": {"const": 1},
    "trips": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {
      "type": "object", "additionalProperties": false, "required": ["date", "origin", "destination"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "origin": {"type": "string", "minLength": 1},
        "destination": {"type": "string", "minLength": 1},
        "note": {"type": "string", "maxLength": 4000},
        "sourceText": {"type": "string", "maxLength": 4000}
      }
    }}
  }
}
